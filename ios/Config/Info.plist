<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist (GENERATE_INFOPLIST_FILE): only
	     keys that build settings cannot express live here. -->
	<!-- The app speaks Russian only: system strings (Назад, Отмена in
	     share sheets) follow this, not the project's development region. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>ru</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<!-- Deep links (vetka://post/42) and the Telegram sign-in callback. -->
			<key>CFBundleURLName</key>
			<string>laviosa.branch</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>vetka</string>
			</array>
		</dict>
	</array>
	<!-- iOS asks before an app talks to devices on the Wi-Fi; a debug build
	     on a phone does, to reach the backend on the Mac. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Нужно, чтобы подключиться к серверу разработки на вашем компьютере.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Plain HTTP to localhost and the local network only: the dev
		     backend. Internet traffic stays HTTPS-only. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
