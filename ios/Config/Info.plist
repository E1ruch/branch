<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist (GENERATE_INFOPLIST_FILE): only
	     keys that build settings cannot express live here. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<!-- Deep links (vetka://post/42) and the Telegram sign-in callback. -->
			<key>CFBundleURLName</key>
			<string>laviosa.branch</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>vetka</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Plain HTTP to localhost and the local network only: the dev
		     backend. Internet traffic stays HTTPS-only. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
