# Скопируй в .env и поменяй нужное. Значения ниже совпадают с дефолтами.
HTTP_ADDR=:8080
REQUEST_TIMEOUT=10s
SHUTDOWN_TIMEOUT=15s
DATABASE_URL=postgres://vetka:vetka@localhost:5432/vetka?sslmode=disable
DB_MAX_CONNS=20
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=info
LOG_FORMAT=text

# Ed25519-ключ подписи access-токенов: openssl rand -base64 32
# Пусто — временный ключ, все сессии слетают при перезапуске.
JWT_SIGNING_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=1440h
REFRESH_GRACE=30s

APPLE_BUNDLE_ID=laviosa.branch
# Бот из @BotFather; домен PUBLIC_BASE_URL привязывается к нему через /setdomain.
# Оба пусты — вход через Telegram выключен.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Локальный вход без настоящего бота: форма вместо виджета, сервер сам
# подписывает данные. Нужны любые TELEGRAM_BOT_TOKEN/USERNAME и http://
# в PUBLIC_BASE_URL (с https сервер откажется стартовать).
# TELEGRAM_BOT_TOKEN=dev-fake-token
# TELEGRAM_BOT_USERNAME=vetka_dev_bot
# TELEGRAM_FAKE_LOGIN=true

PUBLIC_BASE_URL=http://localhost:8080
APP_URL_SCHEME=vetka

TEST_DATABASE_URL=postgres://vetka:vetka@localhost:5432/vetka?sslmode=disable
