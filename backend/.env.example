# Скопируй в .env и поменяй нужное. Значения ниже совпадают с дефолтами.
HTTP_ADDR=:8080
REQUEST_TIMEOUT=10s
SHUTDOWN_TIMEOUT=15s
DATABASE_URL=postgres://vetka:vetka@localhost:5432/vetka?sslmode=disable
DB_MAX_CONNS=20
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=info
LOG_FORMAT=text

# Ed25519-ключ подписи access-токенов: openssl rand -base64 32
# Пусто — временный ключ, все сессии слетают при перезапуске.
JWT_SIGNING_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=1440h
REFRESH_GRACE=30s

APPLE_BUNDLE_ID=laviosa.branch
# Бот из @BotFather; домен PUBLIC_BASE_URL привязывается к нему через /setdomain.
# Оба пусты — вход через Telegram выключен.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Локальный вход без настоящего бота: форма вместо виджета, сервер сам
# подписывает данные. Нужны любые TELEGRAM_BOT_TOKEN/USERNAME и http://
# в PUBLIC_BASE_URL (с https сервер откажется стартовать).
# TELEGRAM_BOT_TOKEN=dev-fake-token
# TELEGRAM_BOT_USERNAME=vetka_dev_bot
# TELEGRAM_FAKE_LOGIN=true

PUBLIC_BASE_URL=http://localhost:8080
APP_URL_SCHEME=vetka

TEST_DATABASE_URL=postgres://vetka:vetka@localhost:5432/vetka?sslmode=disable

# Локальные MinIO и imgproxy поднимает make media-up. Значения для разработки.
# Для iPhone укажи доступные по Wi-Fi адреса загрузки и выдачи и MEDIA_BIND_ADDR.
MEDIA_ENABLED=false
MEDIA_S3_ENDPOINT=http://127.0.0.1:9000
MEDIA_UPLOAD_ENDPOINT=http://127.0.0.1:9000
MEDIA_IMGPROXY_URL=http://127.0.0.1:8090
MEDIA_BIND_ADDR=127.0.0.1
MEDIA_S3_BUCKET=vetka-media
MEDIA_S3_REGION=us-east-1
MEDIA_S3_PATH_STYLE=true
MEDIA_S3_ACCESS_KEY=vetka-local
MEDIA_S3_SECRET_KEY=vetka-local-media-secret
MEDIA_IMGPROXY_KEY=be294336dd4a24b75ed66324f1dfa1913c5636fd56c9ce04c2f289a204341318
MEDIA_IMGPROXY_SALT=eff5649cc662013426e679e0bf9d021cdf0ab3b88ca6709fa4ef62b7fba826d2
